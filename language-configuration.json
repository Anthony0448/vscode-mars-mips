{
    "comments": {
        "lineComment": "#"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:[A-Za-z_.$][\\w.$]*\\s*:|\\.macro\\s+[A-Za-z_.$][\\w.$]*|\\.(?:k?data|k?text))\\s*(?:[#;].*)?$",
            "action": { "indent": "indent" }
        }
    ],
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@#%^&*()=+[{\\]}\\\\|;:'\",.<>/?\\s]+)",
    // symbols used as brackets
    "brackets": [["(", ")"]],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ]
}
