{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Mipsy",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#registers"
        },
        {
            "include": "#instructions"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#chars"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#commas"
        }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.number-sign.mips",
            "begin": "#",
            "end": "$"
        },
        "directives": {
            "name": "keyword.control.directive.mips",
            "match": "(?<![\\w.$])\\.(?i:end_macro|include|asciiz|double|extern|align|ascii|float|globl|kdata|ktext|macro|space|byte|data|half|text|word|eqv|set)(?![\\w.])"
        },
        "labels": {
            "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
            "captures": {
                "1": {
                    "name": "support.class.label.mips"
                },
                "2": {
                    "name": "punctuation.separator.label.mips"
                }
            }
        },
        "instructions": {
            "patterns": [
                {
                    "name": "support.function.instruction.mips",
                    "match": "(?<![\\w.$])(?i:floor\\.w\\.d|floor\\.w\\.s|round\\.w\\.d|round\\.w\\.s|trunc\\.w\\.d|trunc\\.w\\.s|ceil\\.w\\.d|ceil\\.w\\.s|cvt\\.d\\.s|cvt\\.d\\.w|cvt\\.s\\.d|cvt\\.s\\.w|cvt\\.w\\.d|cvt\\.w\\.s|syscall|bgezal|bltzal|c\\.eq\\.d|c\\.eq\\.s|c\\.le\\.d|c\\.le\\.s|c\\.lt\\.d|c\\.lt\\.s|movf\\.d|movf\\.s|movn\\.d|movn\\.s|movt\\.d|movt\\.s|movz\\.d|movz\\.s|sqrt\\.d|sqrt\\.s|abs\\.d|abs\\.s|add\\.d|add\\.s|addiu|break|div\\.d|div\\.s|maddu|mov\\.d|mov\\.s|msubu|mul\\.d|mul\\.s|multu|neg\\.d|neg\\.s|sltiu|sub\\.d|sub\\.s|tgeiu|tltiu|addi|addu|andi|bc1f|bc1t|bgez|bgtz|blez|bltz|divu|eret|jalr|ldc1|lwc1|madd|mfc0|mfc1|mfhi|mflo|movf|movn|movt|movz|msub|mtc0|mtc1|mthi|mtlo|mult|sdc1|sllv|slti|sltu|srav|srlv|subu|swc1|teqi|tgei|tgeu|tlti|tltu|tnei|xori|add|and|beq|bne|clo|clz|div|jal|lbu|lhu|lui|lwl|lwr|mul|nop|nor|ori|sll|slt|sra|srl|sub|swl|swr|teq|tge|tlt|tne|xor|jr|lb|lh|ll|lw|or|sb|sc|sh|sw|j)(?![\\w.])"
                },
                {
                    "name": "support.function.pseudoinstruction.mips",
                    "match": "(?<![\\w.$])(?i:mfc1\\.d|mtc1\\.d|mulou|subiu|beqz|bgeu|bgtu|bleu|bltu|bnez|move|mulo|mulu|negu|remu|sgeu|sgtu|sleu|subi|ulhu|abs|bge|bgt|ble|blt|l\\.d|l\\.s|neg|not|rem|rol|ror|s\\.d|s\\.s|seq|sge|sgt|sle|sne|ulh|ulw|ush|usw|la|ld|li|sd|b)(?![\\w.])"
                }
            ]
        },
        "registers": {
            "patterns": [
                {
                    "name": "variable.language.register.number.mips",
                    "match": "(\\$(3[01]|[12][0-9]|[0-9]))\\b"
                },
                {
                    "name": "variable.language.register.zero.mips",
                    "match": "(\\$zero)\\b"
                },
                {
                    "name": "variable.language.register.at.mips",
                    "match": "(\\$at)\\b"
                },
                {
                    "name": "variable.language.register.value.mips",
                    "match": "(\\$v[0-1])\\b"
                },
                {
                    "name": "variable.language.register.argument.mips",
                    "match": "(\\$a[0-3])\\b"
                },
                {
                    "name": "variable.language.register.temporary.mips",
                    "match": "(\\$t[0-9])\\b"
                },
                {
                    "name": "variable.language.register.saved.mips",
                    "match": "(\\$s[0-7])\\b"
                },
                {
                    "name": "variable.language.register.kernel.mips",
                    "match": "(\\$k[0-1])\\b"
                },
                {
                    "name": "variable.language.register.float.mips",
                    "match": "(\\$f(3[01]|[12][0-9]|[0-9]))\\b"
                },
                {
                    "name": "variable.language.register.pointer.mips",
                    "match": "\\$([gsf]p|ra)\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.mips",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.mips",
                    "match": "\\\\."
                }
            ]
        },
        "chars": {
            "name": "string.quoted.single.mips",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape.mips",
                    "match": "\\\\."
                }
            ]
        },
        "numeric": {
            "name": "constant.numeric.mips",
            "match": "-?(0x[0-9a-fA-F]+|0b[01]+|(\\d+(\\.\\d+)?))\\b"
        },
        "constants": {
            "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
            "captures": {
                "1": {
                    "name": "entity.name.function.constant.mips"
                },
                "2": {
                    "name": "keyword.operator.assignment.mips"
                }
            }
        },
        "operators": {
            "name": "keyword.operator.mips",
            "match": "([-+*=])"
        },
        "commas": {
            "name": "punctuation.separator.mips",
            "match": "(,)"
        }
    },
    "scopeName": "source.mips"
}
